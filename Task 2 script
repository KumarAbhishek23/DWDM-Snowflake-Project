-- 1. Create and set Warehouse
CREATE OR REPLACE WAREHOUSE dwdm_wh 
    WITH WAREHOUSE_SIZE = 'XSMALL' 
    AUTO_SUSPEND = 60 
    AUTO_RESUME = TRUE;
USE WAREHOUSE dwdm_wh;

-- 2. Create and set Database & Schema
CREATE OR REPLACE DATABASE dwdm_db;
USE DATABASE dwdm_db;

CREATE OR REPLACE SCHEMA dwdm_schema;
USE SCHEMA dwdm_schema;

-- 3. Create Internal Stage
CREATE OR REPLACE STAGE my_internal_stage;

-- 4. Create Table with new schema structure
CREATE OR REPLACE TABLE university_students (
    roll_no INT,
    student_name STRING,
    major STRING,
    cgpa FLOAT
);

