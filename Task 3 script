-- Ensure context
USE WAREHOUSE dwdm_wh;
USE DATABASE dwdm_db;
USE SCHEMA dwdm_schema;

-- Stage local file
PUT file://C:\temp\batch_students.csv @dwdm_db.dwdm_schema.my_internal_stage AUTO_COMPRESS=TRUE;

-- Verify staging
LIST @my_internal_stage;

-- Load staged CSV into table
COPY INTO university_students
FROM @my_internal_stage/batch_students.csv.gz
FILE_FORMAT = (
    TYPE = 'CSV' 
    FIELD_DELIMITER = ',' 
    SKIP_HEADER = 0
);

-- Verify ingestion
SELECT * FROM university_students;
